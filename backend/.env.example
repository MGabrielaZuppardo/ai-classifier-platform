# Copie para .env (ignorado pelo git) e ajuste. Valores só para desenvolvimento.
# Nunca commite segredos reais. Cada ambiente (dev, staging, produção) usa o seu.

# --- Aplicação ---
APP_ENVIRONMENT=development
APP_DEBUG=false

# --- Banco e fila ---
APP_DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app
APP_REDIS_URL=redis://localhost:6379/0

# --- Login com GitHub (OAuth App: Settings > Developer settings > OAuth Apps) ---
# Um OAuth App por ambiente, com a URL de retorno correspondente.
APP_GITHUB_CLIENT_ID=
APP_GITHUB_CLIENT_SECRET=
APP_GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/github/callback
# Idade mínima da conta GitHub para cadastro, em dias (0 desativa a regra).
APP_GITHUB_MIN_ACCOUNT_AGE_DAYS=7

# --- Tokens e sessão ---
# Em development há um valor padrão inseguro. Fora de development, defina ambos
# com 32+ caracteres aleatórios, por exemplo: python -c "import secrets; print(secrets.token_urlsafe(48))"
# APP_JWT_SECRET=
# APP_SESSION_SECRET=
APP_ACCESS_TOKEN_TTL_MINUTES=15
APP_REFRESH_TOKEN_TTL_DAYS=30
# Obrigatório como true fora de development (exige HTTPS).
APP_COOKIE_SECURE=false
